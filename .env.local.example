# Copiar a .env.local y completar con valores reales (nunca commitear .env.local)

# Sanity (CMS / panel de autoadministración) — ver docs/manual-desarrollo.md §8.4
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Resend (envío de email del formulario calificador)
RESEND_API_KEY=

# WhatsApp (número real del estudio, con código de país, sin "+" ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000

# Analytics (GA4)
NEXT_PUBLIC_GA_ID=

# URL pública del sitio (para sitemap.xml, robots.txt y JSON-LD)
NEXT_PUBLIC_SITE_URL=https://estudio-demo.example
