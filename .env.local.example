# Copiar a .env.local y completar con valores reales (nunca commitear .env.local)

# Sanity (CMS / panel de autoadministración) — ver docs/manual-desarrollo.md §8.4
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
# Dataset PRIVADO solo para consultas (datos personales). Sin esto, las consultas
# llegan únicamente por email. Crear con: npx sanity dataset create consultas --visibility private
SANITY_LEADS_DATASET=

# Acceso al panel /studio (primera barrera, antes del login de Sanity).
# Sin ADMIN_PASSWORD el panel queda cerrado en producción.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Resend (envío de email del formulario calificador)
RESEND_API_KEY=

# WhatsApp (número real del estudio, con código de país, sin "+" ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000

# Analytics (GA4)
NEXT_PUBLIC_GA_ID=

# URL pública del sitio (para sitemap.xml, robots.txt y JSON-LD)
NEXT_PUBLIC_SITE_URL=https://iturbelavalle.example

# Remitente y destinatario de los emails de consultas (opcionales).
# RESEND_FROM necesita un dominio verificado en Resend; LEADS_EMAIL por defecto usa el email del estudio.
RESEND_FROM=
LEADS_EMAIL=

# 2FA del panel (opcional pero recomendado): secreto base32 generado con
# `node scripts/generar-totp.mjs`. Con esto, la contraseña de /studio se escribe
# seguida del código de 6 dígitos de la app (sin espacio). ADMIN_PASSWORD: mínimo 12.
ADMIN_TOTP_SECRET=
